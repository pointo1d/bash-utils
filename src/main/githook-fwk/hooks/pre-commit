#!/bin/bash
# vim: ai columns=80 et fo+=fr ft=bash sts=2 sw=2
################################################################################
################################################################################
# shellcheck disable=SC2086
: ${GITHOOK_FWK_DEBUG:-}
eval ${GITHOOK_FWK_DEBUG:+shopt -os xtrace}

run-check() {
  local cmd=$1 cmd_str="$1" path="$2"
  # shellcheck disable=SC2059
  cmd="$(printf "$cmd_str" $path)"

  (
    set +x
    exec >"$log" 2>&1
    eval "$cmd"
  )

  if test $? -ne 0; then
    cat<<EOT >&2
Pre-commit: Check ('$cmd') failed for file: '$path'
$(<"$log")
EOT
    exit 1
  else
    builtin echo -e "Pre-commit: Check ('$cmd') passed for file: '$path'" >&2
  fi
}

if test "${GITHOOK_FWK_DEBUG:-}"; then shopt -so xtrace; fi

if git rev-parse --verify HEAD >/dev/null 2>&1
then
	against=HEAD
else
	# Initial commit: diff against an empty tree object
	against=$(git hash-object -t tree /dev/null)
fi

# If you want to allow non-ASCII filenames set this variable to true.
allownonascii=$(git config --type=bool hooks.allownonascii)

# Redirect output to stderr.
exec 1>&2

# Cross platform projects tend to avoid non-ASCII filenames; prevent
# them from being added to the repository. We exploit the fact that the
# printable range starts at the space character and ends with tilde.
# shellcheck disable=SC1009,SC2046
if [ "$allownonascii" != "true" ] &&
  # Note that the use of brackets around a tr range is ok here, (it's even
  # required, for portability to Solaris 10's /usr/bin/tr), since the square
  # bracket bytes happen to fall in the designated range.
  test $(git diff --cached --name-only --diff-filter=A -z $against |
    LC_ALL=C tr -d '[ -~]\0' | wc -c) != 0
then
	cat <<\EOF
Error: Attempt to add a non-ASCII file name.

This can cause problems if you want to work with people on other platforms.

To be portable it is advisable to rename the file.

If you know what you are doing you can disable this check using:

  git config hooks.allownonascii true
EOF
	exit 1
fi

declare Paths=(); readarray Paths < <(
  if test $# -ne 0; then
    printf "M\t%s\n" "$@"
  else
    # shellcheck disable=SC2086
    git diff $against --name-status
  fi
)

if test ${#Paths[@]} -eq 0; then
  builtin echo -e "Pre-commit: No files to check"
  exit 0
fi

declare status from to
# shellcheck disable=SC2034
while IFS="	" read -r status from to; do
  declare path="${to:-$from}"
  if test "${path:-}" = ""; then continue; fi

  declare log=/var/tmp/${path##*/}.log
  # shellcheck disable=SC2064
  trap "rm -f \"$log\"" 0 1 2 15

  if test -s $path; then
    # It's an empty file, but is it allowable/expected
    case "$path" in
      */.gitkeep) continue ;;
    esac
  fi

  declare magic="${path##*.}"
  case "$magic" in
    sh)       # It's notionally a shell script, but there's a special case here
              # in as much as shellspec scripts all take a .sh extension
              if test "$path" != "${path%_spec.sh}"; then magic=spec; fi
              ;;
    "$path")  # File has no extension, so attempt to determine the type of the
              # file using other means e.g. its' magic
              case "$(file "$path")" in
                *Bourne-Again*) # shellcheck disable=SC2209
                                magic=sh
                                ;;
              esac
              ;;
  esac

  case $magic in
    spec)   run-check "shellspec --syntax-check \"%s\"" "$path" ;;
    sh)     if run-check "bash -n \"%s\"" "$path"; then
              if run-check "shellcheck \"%s\"" "$path"; then
                # Syntax & lint checks passed, so finally attempt to find
                # associated unit test(s)
                while read -r f; do
                  run-check "shellspec \"%s\"" $f
                done < <(
                  # shellcheck disable=SC2063
                  git ls-files -c --exclude-standard |
                    grep "${path##*/}*_spec.sh"
                )
              fi
            fi
            ;;
    json)   run-check "sed '/#/s,#.*,,' \"%s\" | jq -e" "$path" ;;
    md)     run-check "mdl \"%s\"" "$path" ;;
    p[lm])  run-check "perl -c \"%s\"" "$path" ;;
    py)     run-check "python -c \"%s\"" "$path" ;;
    rb)     if run-check "ruby -c \"%s\"" "$path"; then
                run-check "rubocop \"%s\"" "$path"
              fi
              ;;
  esac
done < <(printf "%s\n" "${Paths[@]}")

if test $# -eq 0; then
  # If there are whitespace errors, print the offending file names and fail.
  # shellcheck disable=SC2086
  git diff-index --check --cached $against --
fi

if test "${GITHOOK_FWK_COMMIT_FAIL:-}"; then
  builtin echo -e "Pre-commit: Check(s) failed (user abort)" >&2
  exit 1
fi

#### END OF FILE
